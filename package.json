{
  "name": "cryptostats",
  "version": "1.0.3",
  "description": "",
  "main": "_build/bundle.js",
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "browser-sync": "^3.0.4",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "html-minifier-terser": "^7.2.0",
    "ismobilejs": "^1.1.1",
    "npm-run-all2": "^9.0.3",
    "onchange": "^7.1.0",
    "postcss-cli": "^12.0.0",
    "sass": "^1.104.0",
    "terser": "^5.51.2",
    "vite": "^8.2.2"
  },
  "scripts": {
    "html": "html-minifier-terser --collapse-whitespace --remove-comments --input-dir ./_html --output-dir ./ --file-ext html",
    "css:sass": "sass --style compressed --no-source-map ./_scss/style.scss ./_build/bundle.css",
    "css:postcss": "postcss --output ./_build/bundle.css ./_build/bundle.css",
    "css": "npm-run-all --sequential css:sass css:postcss",
    "js:vite": "vite build --logLevel error",
    "js:minify": "terser --compress --mangle --comments false --output ./_build/bundle.js ./_build/bundle.js",
    "js": "npm-run-all --sequential js:vite js:minify",
    "browsersync": "browser-sync start --reload-debounce 3000 --proxy cryptostats.local --no-open --files \"./_build/*.css, ./_build/*.js, ./index.html\"",
    "watch:html": "onchange ./_html/*.html --initial -- npm run html --silent",
    "watch:css": "onchange ./_scss/*.scss ./_scss/**/*.scss --initial -- npm run css --silent",
    "watch:js": "onchange ./_js/*.js ./_js/**/*.js --initial -- npm run js --silent",
    "prod": "npm-run-all --sequential html css js",
    "dev": "npm-run-all --parallel watch:* browsersync"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "ws": "^8.21.0",
    "browser-sync": {
      "immutable": "^4.3.9",
      "browser-sync-ui": {
        "immutable": "^4.3.9"
      }
    }
  },
  "author": "",
  "license": "ISC",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
